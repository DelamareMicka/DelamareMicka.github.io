% ---------------------------------------------------------------------------
% Bibliographie — rendue automatiquement par jekyll-scholar sur /publications/
%
% Les 3 entrées ci-dessous sont des GABARITS D'EXEMPLE (une revue, une
% conférence, un preprint), pas de vraies publications. Le titre, les
% auteur·rice·s, la revue/conférence, le DOI (10.1000/xxxxx est le préfixe
% DOI réservé à la documentation par l'IANA — il ne pointe vers rien) et
% l'ID arXiv sont des placeholders explicites [À COMPLÉTER] à remplacer par
% de vraies références.
%
% Convention pour ajouter une nouvelle publication :
% 1. Choisir le type BibTeX adapté : type "article" (revue), type
%    "inproceedings" (conférence/actes), type "misc" ou "unpublished"
%    (preprint/working paper).
% 2. Clé de citation : nomAnnéeMotClé (ex. delamare2025bai), en minuscules,
%    sans espaces ni accents.
% 3. Champs qui activent les badges sur la fiche publication :
%      - doi:      ajoute un badge DOI + lien direct
%      - pdf:      nom de fichier dans assets/pdf/ (ou URL complète)
%      - arxiv:    identifiant arXiv (ex. 2401.01234) -> badge + lien arXiv
%      - abstract: affiche un bouton "Abstract" qui déplie le résumé
%      - selected: {true} -> fait apparaître l'entrée dans la liste
%                  "Selected papers" de la page d'accueil (about.md)
%      - html/website/code/poster/slides/video/supp: liens optionnels
%        supplémentaires (voir README.md du thème pour la liste complète)
% 4. Champ `abbr` : court insigne affiché à gauche de l'entrée (nom de la
%    revue/conférence en abrégé).
% 5. Pour un preprint qui devient ensuite un article publié, garder la même
%    clé et simplement ajouter/mettre à jour les champs (journal, doi, etc.)
%    plutôt que de dupliquer l'entrée.
% ---------------------------------------------------------------------------

@article{delamareXXXXjournal,
  abbr      = {[À COMPLÉTER]},
  title     = {[À COMPLÉTER — titre de l'article de revue]},
  author    = {Delamare, Mickaël and Coauteur, Prenom},
  journal   = {[À COMPLÉTER — nom de la revue]},
  volume    = {[À COMPLÉTER]},
  number    = {[À COMPLÉTER]},
  pages     = {[À COMPLÉTER]},
  year      = {20XX},
  doi       = {10.1000/xxxxx},
  pdf       = {example_pdf.pdf},
  abstract  = {[À COMPLÉTER — résumé de l'article]},
  selected  = {true}
}

@inproceedings{delamareXXXXconference,
  abbr      = {[À COMPLÉTER]},
  title     = {[À COMPLÉTER — titre de l'article de conférence]},
  author    = {Delamare, Mickaël and Coauteur, Prenom},
  booktitle = {[À COMPLÉTER — nom de la conférence, ex. International Conference on Artificial Intelligence in Education (AIED)]},
  pages     = {[À COMPLÉTER]},
  year      = {20XX},
  doi       = {10.1000/xxxxx},
  pdf       = {example_pdf.pdf},
  abstract  = {[À COMPLÉTER — résumé de l'article]},
  selected  = {true}
}

@misc{delamareXXXXpreprint,
  abbr      = {Preprint},
  title     = {[À COMPLÉTER — titre du preprint]},
  author    = {Delamare, Mickaël and Coauteur, Prenom},
  year      = {20XX},
  eprint    = {[À COMPLÉTER — ex. 2401.01234]},
  arxiv     = {[À COMPLÉTER — ex. 2401.01234]},
  archiveprefix = {arXiv},
  pdf       = {example_pdf.pdf},
  abstract  = {[À COMPLÉTER — résumé du preprint]}
}
