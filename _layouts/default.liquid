<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Language toggle: applied before first paint to avoid a flash of the
       wrong language. Persisted in localStorage, read by every page. -->
  <script>
    (function () {
      try {
        if (localStorage.getItem('lang-pref') === 'en') {
          document.documentElement.setAttribute('data-lang', 'en');
        }
      } catch (e) {}
    })();
  </script>
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    <style>
      /* Bilingual content toggle (about.md, cv.md, projects, etc.):
         .lang-fr / .lang-en wrap the French / English version of the same
         block or inline text; html[data-lang="en"] flips which one shows.
         !important: some theme components (e.g. the about page's
         .profile .more-info p rule) set their own `display` on the same
         elements with higher selector specificity, which would otherwise
         make both languages show at once. */
      .lang-en, .lang-en-i { display: none !important; }
      html[data-lang="en"] .lang-fr { display: none !important; }
      html[data-lang="en"] .lang-en { display: block !important; }
      html[data-lang="en"] .lang-fr-i { display: none !important; }
      html[data-lang="en"] .lang-en-i { display: inline !important; }

      /* Language switcher dropdown: self-contained show/hide and button
         reset so it doesn't depend on the theme's Bootstrap CSS being
         wired up for <button> based dropdown-items. */
      .lang-dropdown .dropdown-menu {
        display: none;
      }
      .lang-dropdown .dropdown-menu.show {
        display: block;
      }
      .lang-dropdown .dropdown-item {
        display: block;
        width: 100%;
        padding: 0.35rem 1.2rem;
        clear: both;
        text-align: left;
        white-space: nowrap;
        background: none;
        border: 0;
        cursor: pointer;
      }
      .lang-dropdown .dropdown-item.active {
        font-weight: 700;
      }
    </style>
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}

    <script>
      (function () {
        var toggle = document.getElementById('lang-dropdown-toggle');
        var menu = document.getElementById('lang-dropdown-menu');
        var label = document.getElementById('lang-dropdown-label');
        if (!toggle || !menu) return;

        function apply(lang) {
          if (lang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
          } else {
            document.documentElement.removeAttribute('data-lang');
          }
          if (label) label.textContent = lang === 'en' ? 'EN' : 'FR';
          Array.prototype.forEach.call(menu.querySelectorAll('[data-lang-option]'), function (item) {
            var isActive = item.getAttribute('data-lang-option') === lang;
            item.classList.toggle('active', isActive);
            item.setAttribute('aria-current', isActive ? 'true' : 'false');
          });
        }
        function openMenu() {
          menu.classList.add('show');
          toggle.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
          menu.classList.remove('show');
          toggle.setAttribute('aria-expanded', 'false');
        }

        apply(document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'fr');

        toggle.addEventListener('click', function (e) {
          e.stopPropagation();
          if (menu.classList.contains('show')) {
            closeMenu();
          } else {
            openMenu();
          }
        });
        Array.prototype.forEach.call(menu.querySelectorAll('[data-lang-option]'), function (item) {
          item.addEventListener('click', function () {
            var lang = item.getAttribute('data-lang-option');
            try { localStorage.setItem('lang-pref', lang); } catch (e) {}
            apply(lang);
            closeMenu();
          });
        });
        document.addEventListener('click', function (e) {
          if (!toggle.contains(e.target) && !menu.contains(e.target)) closeMenu();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeMenu();
        });
      })();
    </script>
  </body>
</html>
